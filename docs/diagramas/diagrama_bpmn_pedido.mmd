        C0(["Envía mensaje\no pulsa botón"]) --> C1["Selecciona categoría,\nproducto y cantidad"] --> C2["Confirma\nel pedido"] --> C3(["Recibe confirmación o\naviso de stock insuficiente"]) --> C4(["Recibe notificación de\ncambio de estado"])
    end

